# Copy to .env.demo.agent and fill in the key once.
# The same DeepSeek key can drive Claude Code and OpenCode.

# Shared DeepSeek credentials
DEEPSEEK_API_KEY=

# Claude Code: DeepSeek's Anthropic-compatible endpoint
# https://api-docs.deepseek.com/guides/anthropic_api/
CLAUDE_BASE_URL=https://api.deepseek.com/anthropic
CLAUDE_API_KEY=
CLAUDE_MODEL=deepseek-flash
CLAUDE_SMALL_MODEL=deepseek-flash
CLAUDE_MAX_BUDGET_USD=2
CLAUDE_PERMISSION_MODE=bypassPermissions
CLAUDE_ALLOWED_TOOLS=Bash,Read,Grep,Glob
CLAUDE_TIMEOUT_MS=600000
CLAUDE_APPEND_SYSTEM_PROMPT=This is a recorded developer demo. Answer in concise prose or short bullet lists. Do not use Markdown tables. Keep each answer under 180 words and cite file:line or tool evidence inline. Do not dump raw JSON unless the user explicitly asks for it.
CLAUDE_CONFIG_DIR=
CLAUDE_BIN=claude

# OpenCode: DeepSeek's OpenAI-compatible endpoint
OPENCODE_BASE_URL=https://api.deepseek.com
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek/deepseek-chat
OPENCODE_PORT=4096
OPENCODE_BIN=opencode

# Demo defaults
DEMO_AGENT=claude
DEMO_THEME=chat
DEMO_RGCTL_REPO=../rbuilder
DEMO_FIXTURE=example/coolstore-weblogic
DEMO_MODEL=deepseek-flash
DEMO_VIEWPORT_WIDTH=1920
DEMO_VIEWPORT_HEIGHT=1080
DEMO_PAUSE_MS=1200
DEMO_END_PAUSE_MS=1200
DEMO_INTRO_MS=2800
DEMO_OUTRO_MS=3000
DEMO_TIMEOUT_MS=300000
DEMO_VIDEO_CRF=16
DEMO_VIDEO_ENCODER=
DEMO_VIDEO_BITRATE=10M
DEMO_FFMPEG_BIN=ffmpeg
DEMO_FFPROBE_BIN=ffprobe
DEMO_KEEP_RAW=0
DEMO_PLAYWRIGHT_CHROMIUM=

# Paths (relative to docs/videos/agent unless absolute)
DEMO_WORK_DIR=.work
DEMO_TRANSCRIPT_DIR=transcripts
DEMO_OUTPUT_DIR=recordings
