# ElevenLabs voiceover settings.
# Copy to .env.voiceover and fill in both values. The real file is ignored.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Quality / delivery
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
VOICEOVER_GAP_MS=350

# Optional: use a specific executable instead of `elevenlabs` on PATH
# or `npx --yes @elevenlabs/cli@1.13.0`.
# ELEVENLABS_CLI=elevenlabs
